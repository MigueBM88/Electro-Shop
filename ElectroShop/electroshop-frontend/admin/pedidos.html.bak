<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ElectroShop Admin - Pedidos</title>
    <link rel="stylesheet" href="../css/styles.css">
</head>

<body>

    <div class="container">
        <h2 style="margin-bottom:0.25rem">🧾 Gestión de Pedidos</h2>
        <p class="text-muted mb-1">Consulta y actualiza el estado de los pedidos</p>

        <div id="alerta" class="alert"></div>

        <div class="filters-bar">
            <select id="fEstado" onchange="cargar()">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendiente de pago</option>
                <option value="pagado">Pagado</option>
                <option value="preparando">En preparación</option>
                <option value="enviado">Enviado</option>
                <option value="entregado">Entregado</option>
                <option value="cancelado">Cancelado</option>
            </select>
        </div>

        <div class="card">
            <div class="table-container">
                <table>
                    <thead>
                        <tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Pago</th><th>Estado</th><th>Cambiar estado</th></tr>
                    </thead>
                    <tbody id="tablaBody">
                        <tr><td colspan="7" class="text-center text-muted">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
            <div id="paginacion" class="text-center text-muted mt-1"></div>
        </div>
    </div>

    <script src="../js/api.js"></script>
    <script src="../js/utils.js"></script>
    <script src="../js/estadoPedido.js"></script>
    <script>
        if (!requiereAdmin()) throw 'no admin';
        renderNavbarAdmin('pedidos');

        var paginaActual = 1;

        async function cargar() {
            var tbody = document.getElementById('tablaBody');
            var params = '?pagina=' + paginaActual + '&limite=15';
            var estado = document.getElementById('fEstado').value;
            if (estado) params += '&estado=' + estado;

            try {
                var r = await apiListarPedidosAdmin(params);
                if (!r.exito) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Error al cargar</td></tr>'; return; }

                var pedidos = r.datos.pedidos;
                if (pedidos.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No hay pedidos</td></tr>';
                    document.getElementById('paginacion').innerHTML = '';
                    return;
                }

                tbody.innerHTML = pedidos.map(function(p) {
                    var cliente = p.usuario ? (p.usuario.nombre + '<br><span class="text-muted" style="font-size:0.72rem">' + p.usuario.correo + '</span>') : '—';
                    var pagoMap = { aprobado: 'badge-success', pendiente: 'badge-warning', rechazado: 'badge-danger' };
                    var pagoBadge = '<span class="badge ' + (pagoMap[p.pago.estado] || 'badge-primary') + '">' + p.pago.estado + '</span>';

                    var opciones = ['pendiente','pagado','preparando','enviado','entregado','cancelado'].map(function(e) {
                        return '<option value="' + e + '"' + (e === p.estado ? ' selected' : '') + '>' + e + '</option>';
                    }).join('');

                    return '<tr>' +
                        '<td><strong>' + p.numero + '</strong></td>' +
                        '<td>' + cliente + '</td>' +
                        '<td>' + formatFecha(p.createdAt) + '</td>' +
                        '<td><strong>' + formatPrecio(p.total) + '</strong></td>' +
                        '<td>' + pagoBadge + '</td>' +
                        '<td>' + estadoPedidoBadge(p.estado) + '</td>' +
                        '<td><select onchange="cambiarEstado(\'' + p._id + '\', this.value)" style="min-width:130px">' + opciones + '</select></td>' +
                        '</tr>';
                }).join('');

                var pag = r.datos.paginacion;
                var pagHTML = 'Página ' + pag.pagina + ' de ' + pag.totalPaginas + ' (' + pag.total + ' pedidos) ';
                if (pag.pagina > 1) pagHTML += '<button class="btn btn-sm btn-outline" onclick="irPagina(' + (pag.pagina - 1) + ')">← Anterior</button> ';
                if (pag.pagina < pag.totalPaginas) pagHTML += '<button class="btn btn-sm btn-outline" onclick="irPagina(' + (pag.pagina + 1) + ')">Siguiente →</button>';
                document.getElementById('paginacion').innerHTML = pagHTML;
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Error de conexión</td></tr>';
            }
        }

        function irPagina(n) { paginaActual = n; cargar(); }

        async function cambiarEstado(id, estado) {
            var r = await apiActualizarEstadoPedido(id, estado);
            if (r.exito) mostrarAlerta('alerta', 'success', 'Estado actualizado a "' + estado + '"');
            else mostrarAlerta('alerta', 'danger', r.mensaje);
            cargar();
        }

        cargar();
    </script>
</body>

</html>
